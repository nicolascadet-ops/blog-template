---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { AUTHORS } from '../data/authors';
import { CATEGORIES } from '../content.config';
import { formatDate, readingTime } from '../site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== lead.id);
const latest = rest.slice(0, 3);
const L = lead.data;
---
<Base bigMast>
  <div class="wrap">
    <article class="lead" aria-labelledby="lead-title">
      <a class="lead-img" href={`/posts/${lead.id}/`} tabindex="-1" aria-hidden="true">
        <Image src={L.cover} alt="" widths={[720, 1080, 1440]} sizes="(min-width: 960px) 62vw, 100vw" loading="eager" fetchpriority="high" />
      </a>
      <div class="lead-text">
        <h2 id="lead-title"><a href={`/posts/${lead.id}/`}>{L.title}</a></h2>
        <p class="lead-dek">{L.dek}</p>
        <p class="meta">
          <a class="cat" href={`/category/${L.category.toLowerCase()}/`}>{L.category}</a>
          <span>By {AUTHORS[L.author].name}</span>
          <span>{readingTime(lead.body)} min read</span>
        </p>
      </div>
    </article>

    <section class="block" aria-labelledby="latest-title">
      <div class="shead"><h2 id="latest-title">Latest</h2></div>
      <div class="grid3">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>

    <section class="block" aria-labelledby="index-title">
      <div class="shead"><h2 id="index-title">By section</h2></div>
      <div class="sections">
        {CATEGORIES.map((c) => (
          <div class="sec">
            <h3><a href={`/category/${c.toLowerCase()}/`}>{c}</a></h3>
            <ol>
              {posts.filter((p) => p.data.category === c).map((p) => (
                <li>
                  <a href={`/posts/${p.id}/`}>{p.data.title}</a>
                  <span class="meta"><span>{formatDate(p.data.date)}</span></span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .lead { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(20px, 3vw, 48px); padding: 40px 0 0; align-items: end; }
  .lead-img img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .lead h2 { font-size: clamp(2.4rem, 4.6vw, 4.4rem); }
  .lead h2 a { text-decoration: none; }
  .lead h2 a:hover { color: var(--cobalt); }
  .lead-dek { margin: 18px 0 18px; font-family: var(--serif); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.45; color: var(--ink-2); }
  @media (max-width: 960px) { .lead { grid-template-columns: 1fr; padding-top: 24px; } }
  .block { margin-top: 96px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px clamp(20px, 3vw, 40px); }
  @media (max-width: 900px) { .grid3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid3 { grid-template-columns: 1fr; } }
  .sections { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .sec h3 { font-size: 1.6rem; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .sec h3 a { text-decoration: none; color: var(--cobalt); }
  .sec ol { list-style: none; margin: 0; padding: 0; }
  .sec li { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; gap: 4px; }
  .sec li a { font-family: var(--serif); font-size: 19px; line-height: 1.3; text-decoration: none; }
  .sec li a:hover { color: var(--cobalt); text-decoration: underline; }
  @media (max-width: 800px) { .sections { grid-template-columns: 1fr; } }
</style>
