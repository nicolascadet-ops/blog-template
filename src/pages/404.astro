---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap" style="padding:80px 0 40px">
    <h1 style="font-size:clamp(3rem,9vw,7rem)">Wrong turn.</h1>
    <p style="margin-top:20px;font-family:var(--serif);font-size:20px;color:var(--ink-2)">We couldn't find that page. <a href="/" style="color:var(--cobalt)">Back to the front page</a>.</p>
  </div>
</Base>
